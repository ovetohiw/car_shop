# Copy to .env and replace CHANGE_ME values. Do not commit .env.

ORACLE_PASSWORD=CHANGE_ME
ORACLE_APP_USER=carshop
ORACLE_APP_PASSWORD=CHANGE_ME

# JDBC URL for XEPDB1 (gvenzl/oracle-xe). Used from stage 2 (JPA).
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@oracle:1521/XEPDB1

# HS256 secret, at least 32 characters
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_VALUE

